NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-unique-random-value-at-least-32-characters
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:5173
# Set a different random 32-byte (64 hex character) key for each purpose in production.
# MFA_ENCRYPTION_KEY=
# BACKUP_ENCRYPTION_KEY=
# BACKUP_DIRECTORY=C:/data/dlas-backups
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
# Free Render real-account setup: see docs/REAL_ACCOUNTS_SETUP.md.
# DLAS_FREE_DEMO=false
# DLAS_DATABASE_DRIVER=libsql
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
# Email providers are chosen automatically: Brevo -> Resend -> Gmail/SMTP.
# API providers require a sender verified in that provider's account.
# BREVO_API_KEY=
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=Masbate Colleges DLAS
# Optional separate verified senders when the providers use different domains:
# BREVO_FROM_EMAIL=
# RESEND_FROM_EMAIL=
# BACKUP_STRATEGY=turso-pitr
# DLAS_RESEARCH_ENABLED=false
# Gmail fallback (use a Google app password, not the normal account password).
# Free Render blocks SMTP port 587: configure at least one HTTPS API above.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASS=
# MAIL_FROM=DLAS Portal <your-sender@gmail.com>
# MAIL_FROM_NAME=Masbate Colleges DLAS
# MAIL_USERNAME and MAIL_PASSWORD aliases are also supported.
# Legacy custom SMTP settings remain supported on hosts that allow SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=DLAS Portal <no-reply@example.edu.ph>
# SMTP_USER=
# SMTP_PASS=
# CLIENT_URL=https://dlas.example.edu.ph
# Enable the server's own one-minute health ping while it is running.
# It cannot wake a suspended Render instance; external monitoring is separate.
# DLAS_SELF_PING_ENABLED=false
# Optional override; otherwise uses RENDER_EXTERNAL_HOSTNAME or CLIENT_URL.
# DLAS_SITE_URL=https://masbate-colleges-digital-literacy.onrender.com
# Research collection requires these approved settings and independent encrypted backups.
# Setting DLAS_RESEARCH_ENABLED=false allows accounts and scored quizzes only.
# RESEARCH_APPROVAL_ID=
# RESEARCH_CONSENT_VERSION=
# RESEARCH_CONSENT_APPROVED=false
# RESEARCH_CONSENT_TEXT=
# RESEARCH_ASSENT_TEXT=
# GUARDIAN_CONSENT_TEXT=
# GUARDIAN_PROCESS_APPROVED=false
# RESEARCHER_NAME=
# RESEARCHER_EMAIL=
# DATA_RETENTION_POLICY=
# Set only when deployed behind a trusted reverse proxy; use a hop count or trusted proxy address list.
# TRUST_PROXY=1
# Optional; defaults to server/db/dlas.db. Use an absolute persistent path in production.
# DLAS_DB_PATH=C:/data/dlas.db
