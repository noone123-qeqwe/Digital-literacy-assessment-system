{
  "name": "dlas-server",
  "version": "1.0.0",
  "description": "Digital Literacy Assessment System - Backend API",
  "main": "server.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node server.js",
    "start:production": "node scripts/start-production.js",
    "check:production": "node scripts/check-production.js",
    "generate:production-keys": "node scripts/generate-production-keys.js",
    "backup": "node scripts/backup-once.js",
    "dev": "node --watch server.js",
    "seed": "node db/seed.js",
    "bootstrap-admin": "node scripts/bootstrap-admin.js",
    "test": "node test_system.js && node test_knowledge.js && node test_curriculum.js && npm run test:bookmarks && npm run test:cloud && npm run test:email && npm run test:ping && node --test scripts/start-production.test.js utils/serveClient.test.js && node test_mfa_policy.js",
    "test:ping": "node --test scripts/ping-site.test.js utils/websitePing.test.js",
    "test:bookmarks": "node test_bookmarks.js",
    "publish:foundations": "node scripts/publish-foundations.js",
    "test:email": "node --test test_email.js",
    "test:cloud": "node --expose-gc --test test_cloud.js test_connection.js",
    "test:libsql": "node scripts/test-libsql.js",
    "verify-backup": "node db/verify-backup.js",
    "ping-site": "node scripts/ping-site.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jstat": "^1.9.6",
    "libsql": "0.5.29",
    "morgan": "^1.10.0",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.14.0"
  }
}
